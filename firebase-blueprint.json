        "viewerUids": { "type": "array", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "authorUid", "authorName", "content", "viewerUids", "createdAt"]
    },
    "CustomerActivity": {
      "title": "CustomerActivity",
      "description": "Nhật ký tương tác và bàn giao khách hàng.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorName": { "type": "string", "maxLength": 120 },
        "actionType": { "type": "string", "maxLength": 80 },
        "description": { "type": "string", "maxLength": 1000 },
        "viewerUids": { "type": "array", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "actorUid", "actorName", "actionType", "description", "viewerUids", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Hội thoại Messenger đa Fanpage.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "customerAvatar": { "type": "string", "maxLength": 500 },
        "pageId": { "type": "string", "maxLength": 128 },
        "pageName": { "type": "string", "maxLength": 200 },
        "facebookUserId": { "type": "string", "maxLength": 128 },
        "lastMessage": { "type": "string", "maxLength": 1000 },
        "unreadCount": { "type": "number" },
        "isImportant": { "type": "boolean" },
        "hasPhone": { "type": "boolean" },
        "assignedToUid": { "type": "string", "maxLength": 128 },
        "assignedToName": { "type": "string", "maxLength": 120 },
        "status": { "type": "string", "enum": ["OPEN", "IN_PROGRESS", "RESOLVED", "ARCHIVED"] },
        "tags": { "type": "array", "maxLength": 10 },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "viewerUids": { "type": "array", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "customerName", "pageId", "pageName", "lastMessage", "unreadCount", "status", "createdByUid", "viewerUids", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Tin nhắn chi tiết trong hội thoại Messenger.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderType": { "type": "string", "enum": ["CUSTOMER", "AGENT", "SYSTEM"] },
        "senderUid": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 120 },
        "text": { "type": "string", "maxLength": 4000 },
        "attachmentUrl": { "type": "string", "maxLength": 500 },
        "attachmentType": { "type": "string", "maxLength": 40 },
        "deliveryStatus": { "type": "string", "enum": ["RECEIVED", "SENT", "DELIVERED", "FAILED"] },
        "extractedPhones": { "type": "array", "maxLength": 5 },
        "viewerUids": { "type": "array", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "senderType", "senderUid", "senderName", "text", "deliveryStatus", "viewerUids", "createdAt"]
    },
    "Property": {
      "title": "Property",
      "description": "Sản phẩm bất động sản trong giỏ hàng CRM.",
