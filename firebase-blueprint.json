  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Tài khoản người dùng và vai trò RBAC."
    },
    "/staff_directory/{userId}": {
      "schema": { "$ref": "#/entities/StaffDirectoryEntry" },
      "description": "Danh bạ nhân viên không chứa PII để hiển thị phân công."
    },
    "/teams/{teamId}": {
      "schema": { "$ref": "#/entities/Team" },
      "description": "Nhóm nhân viên kinh doanh."
    },
    "/facebook_pages/{pageId}": {
      "schema": { "$ref": "#/entities/FacebookPage" },
      "description": "Fanpage Facebook kết nối."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Hồ sơ khách hàng bất động sản."
    },
    "/customers/{customerId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/CustomerNote" },
      "description": "Ghi chú chăm sóc khách hàng."
    },
    "/customers/{customerId}/activities/{activityId}": {
      "schema": { "$ref": "#/entities/CustomerActivity" },
      "description": "Lịch sử chăm sóc và bàn giao khách hàng."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Hội thoại Messenger."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Tin nhắn trong hội thoại."
    },
    "/properties/{propertyId}": {
      "schema": { "$ref": "#/entities/Property" },
      "description": "Danh mục bất động sản."
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Công việc chăm sóc khách hàng."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Lịch hẹn xem bất động sản."
    },
    "/ai_analyses/{analysisId}": {
      "schema": { "$ref": "#/entities/AiAnalysis" },
      "description": "Lịch sử phân tích nhu cầu bất động sản bằng AI."
    },
    "/tags/{tagId}": {
      "schema": { "$ref": "#/entities/Tag" },
      "description": "Thẻ phân loại khách hàng."
    },
    "/customer_sources/{sourceId}": {
      "schema": { "$ref": "#/entities/CustomerSource" },
      "description": "Nguồn khách hàng."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
