        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "sourceText": { "type": "string", "maxLength": 4000 },
        "phone": { "type": "string", "maxLength": 32 },
        "intent": { "type": "string", "maxLength": 40 },
        "propertyType": { "type": "string", "maxLength": 40 },
        "province": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "budgetMin": { "type": "number" },
