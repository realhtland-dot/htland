        "totalMessages": { "type": "number" },
        "connectedByUid": { "type": "string", "maxLength": 128 },
        "lastError": { "type": "string", "maxLength": 500 },
        "viewerUids": { "type": "array", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "pageId", "name", "connectionStatus", "webhookSubscribed", "aiEnabled", "autoAssignRule", "connectedByUid", "viewerUids", "createdAt", "updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Hồ sơ khách hàng bất động sản CRM.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 150 },
        "primaryPhone": { "type": "string", "maxLength": 32 },
        "phones": { "type": "array", "maxLength": 10 },
        "facebookId": { "type": "string", "maxLength": 128 },
        "facebookName": { "type": "string", "maxLength": 150 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
