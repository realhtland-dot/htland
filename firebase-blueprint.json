        "propertyType": { "type": "string", "maxLength": 80 },
        "province": { "type": "string", "maxLength": 100 },
        "district": { "type": "string", "maxLength": 100 },
        "budgetMin": { "type": "number" },
        "budgetMax": { "type": "number" },
        "areaMin": { "type": "number" },
        "areaMax": { "type": "number" },
        "legalRequirement": { "type": "string", "maxLength": 200 },
        "leadScore": { "type": "number" },
        "priority": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "status": { "type": "string", "maxLength": 80 },
        "assignedToUid": { "type": "string", "maxLength": 128 },
        "assignedToName": { "type": "string", "maxLength": 120 },
        "tags": { "type": "array", "maxLength": 10 },
        "notesSummary": { "type": "string", "maxLength": 1000 },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "viewerUids": { "type": "array", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "fullName", "phones", "intent", "priority", "status", "createdByUid", "viewerUids", "createdAt", "updatedAt"]
    },
    "CustomerNote": {
      "title": "CustomerNote",
      "description": "Ghi chú chăm sóc nội bộ của nhân viên cho khách hàng.",
