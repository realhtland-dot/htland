        "viewerUids": { "type": "array", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "code", "title", "propertyType", "transactionType", "province", "district", "areaSqm", "priceVnd", "status", "ownerUid", "viewerUids", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Công việc chăm sóc khách hàng.",
