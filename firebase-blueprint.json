{
  "entities": {
    "User": {
      "title": "User",
      "description": "Tài khoản nhân viên trong hệ thống CRM (chứa thông tin cá nhân PII được bảo vệ).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "MANAGER", "SALE"] },
        "teamId": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "assignedPageIds": { "type": "array", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "status", "createdAt", "updatedAt"]
    },
    "StaffDirectoryEntry": {
      "title": "StaffDirectoryEntry",
      "description": "Danh bạ nhân viên không chứa thông tin nhạy cảm dùng cho phân công hội thoại và khách hàng.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "MANAGER", "SALE"] },
        "teamId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "viewerUids": { "type": "array", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "status", "viewerUids", "createdAt", "updatedAt"]
    },
    "Team": {
      "title": "Team",
      "description": "Nhóm kinh doanh bất động sản theo khu vực hoặc dự án.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "leaderUid": { "type": "string", "maxLength": 128 },
        "leaderName": { "type": "string", "maxLength": 120 },
        "region": { "type": "string", "maxLength": 120 },
        "memberUids": { "type": "array", "maxLength": 50 },
        "viewerUids": { "type": "array", "maxLength": 50 },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "leaderUid", "region", "viewerUids", "createdByUid", "createdAt", "updatedAt"]
    },
    "FacebookPage": {
      "title": "FacebookPage",
      "description": "Thông tin Fanpage Facebook kết nối Messenger (không lưu token thô).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "pageId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 120 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "connectionStatus": { "type": "string", "enum": ["CONNECTED", "EXPIRED", "DISCONNECTED"] },
