        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "customerName", "location", "scheduledAt", "status", "assignedToUid", "createdByUid", "viewerUids", "createdAt", "updatedAt"]
    },
    "AiAnalysis": {
