        && incoming().updatedAt == request.time;
      allow update: if isValidId(teamId) && isManagerOrAbove() && isValidTeam(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'region', 'memberUids', 'viewerUids', 'updatedAt'])
        );
      allow delete: if isValidId(teamId) && isAdmin();
