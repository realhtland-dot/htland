        && incoming().connectedByUid == existing().connectedByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['aiEnabled', 'autoAssignRule', 'connectionStatus', 'webhookSubscribed', 'totalConversations', 'totalCustomers', 'totalMessages', 'lastError', 'viewerUids', 'updatedAt'])
        );
      allow delete: if isValidId(pageId) && isAdmin();
    }

    // 5. Customers
    match /customers/{customerId} {
      allow get: if isValidId(customerId) && isVerified() && (isAdmin() || existing().assignedToUid == request.auth.uid || existing().createdByUid == request.auth.uid || request.auth.uid in existing().viewerUids);
      allow list: if isVerified() && (isBootstrappedAdmin() || resource.data.assignedToUid == request.auth.uid || resource.data.createdByUid == request.auth.uid || request.auth.uid in resource.data.viewerUids);
      allow create: if isValidId(customerId) && isVerified() && isValidCustomer(incoming())
        && incoming().id == customerId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(customerId) && isVerified() && isValidCustomer(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          ((existing().assignedToUid == request.auth.uid || existing().createdByUid == request.auth.uid || request.auth.uid in existing().viewerUids)
            && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'primaryPhone', 'phones', 'intent', 'propertyType', 'province', 'district', 'budgetMin', 'budgetMax', 'areaMin', 'areaMax', 'legalRequirement', 'leadScore', 'priority', 'status', 'tags', 'notesSummary', 'assignedToUid', 'assignedToName', 'viewerUids', 'updatedAt']))
        );
      allow delete: if isValidId(customerId) && isAdmin();

      // Subcollection: Notes (Master Gate)
      match /notes/{noteId} {
        allow get: if isValidId(customerId) && isValidId(noteId) && isVerified()
          && exists(/databases/$(database)/documents/customers/$(customerId))
          && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/customers/$(customerId)).data.viewerUids);
        allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.viewerUids);
        allow create: if isValidId(customerId) && isValidId(noteId) && isVerified() && isValidCustomerNote(incoming())
          && (
            (exists(/databases/$(database)/documents/customers/$(customerId))
              && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/customers/$(customerId)).data.viewerUids))
            || (existsAfter(/databases/$(database)/documents/customers/$(customerId))
              && (isAdmin() || request.auth.uid in getAfter(/databases/$(database)/documents/customers/$(customerId)).data.viewerUids))
          )
          && incoming().id == noteId
          && incoming().customerId == customerId
          && incoming().authorUid == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(customerId) && isValidId(noteId) && isAdmin();
      }

      // Subcollection: Activities (Master Gate)
      match /activities/{activityId} {
        allow get: if isValidId(customerId) && isValidId(activityId) && isVerified()
          && exists(/databases/$(database)/documents/customers/$(customerId))
          && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/customers/$(customerId)).data.viewerUids);
        allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.viewerUids);
        allow create: if isValidId(customerId) && isValidId(activityId) && isVerified() && isValidCustomerActivity(incoming())
          && (
            (exists(/databases/$(database)/documents/customers/$(customerId))
              && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/customers/$(customerId)).data.viewerUids))
            || (existsAfter(/databases/$(database)/documents/customers/$(customerId))
              && (isAdmin() || request.auth.uid in getAfter(/databases/$(database)/documents/customers/$(customerId)).data.viewerUids))
          )
          && incoming().id == activityId
          && incoming().customerId == customerId
          && incoming().actorUid == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(customerId) && isValidId(activityId) && isAdmin();
      }
    }

    // 6. Conversations
    match /conversations/{conversationId} {
      allow get: if isValidId(conversationId) && isVerified() && (isAdmin() || existing().assignedToUid == request.auth.uid || request.auth.uid in existing().viewerUids);
      allow list: if isVerified() && (isBootstrappedAdmin() || resource.data.assignedToUid == request.auth.uid || request.auth.uid in resource.data.viewerUids);
      allow create: if isValidId(conversationId) && isVerified() && isValidConversation(incoming())
        && incoming().id == conversationId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(conversationId) && isVerified() && isValidConversation(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().status != 'ARCHIVED'
            && (existing().assignedToUid == request.auth.uid || request.auth.uid in existing().viewerUids)
            && (
              incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'unreadCount', 'hasPhone', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['isImportant', 'tags', 'status', 'updatedAt']) ||
              incoming().diff(existing()).affectedKeys().hasOnly(['assignedToUid', 'assignedToName', 'viewerUids', 'updatedAt'])
            ))
        );
      allow delete: if isValidId(conversationId) && isAdmin();

      // Subcollection: Messages (Master Gate)
      match /messages/{messageId} {
        allow get: if isValidId(conversationId) && isValidId(messageId) && isVerified()
          && exists(/databases/$(database)/documents/conversations/$(conversationId))
          && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.viewerUids);
        allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.viewerUids);
        allow create: if isValidId(conversationId) && isValidId(messageId) && isVerified() && isValidMessage(incoming())
          && (
            (exists(/databases/$(database)/documents/conversations/$(conversationId))
              && (isAdmin() || request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.viewerUids))
            || (existsAfter(/databases/$(database)/documents/conversations/$(conversationId))
              && (isAdmin() || request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.viewerUids))
          )
          && incoming().id == messageId
          && incoming().conversationId == conversationId
          && incoming().senderUid == request.auth.uid
          && incoming().createdAt == request.time;
        allow update: if isValidId(conversationId) && isValidId(messageId) && isAdmin() && isValidMessage(incoming());
        allow delete: if isValidId(conversationId) && isValidId(messageId) && isAdmin();
      }
    }

    // 7. Properties
    match /properties/{propertyId} {
      allow get: if isValidId(propertyId) && isVerified() && (isAdmin() || existing().ownerUid == request.auth.uid || request.auth.uid in existing().viewerUids);
      allow list: if isVerified() && (isBootstrappedAdmin() || resource.data.ownerUid == request.auth.uid || request.auth.uid in resource.data.viewerUids);
      allow create: if isValidId(propertyId) && isVerified() && isValidProperty(incoming())
        && incoming().id == propertyId
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(propertyId) && isVerified() && isValidProperty(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          ((existing().ownerUid == request.auth.uid || isManagerOrAbove())
            && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'propertyType', 'transactionType', 'province', 'district', 'areaSqm', 'priceVnd', 'legalStatus', 'status', 'imageUrl', 'description', 'viewerUids', 'updatedAt']))
        );
      allow delete: if isValidId(propertyId) && isAdmin();
    }

    // 8. Tasks
    match /tasks/{taskId} {
      allow get: if isValidId(taskId) && isVerified() && (isAdmin() || existing().assignedToUid == request.auth.uid || request.auth.uid in existing().viewerUids);
      allow list: if isVerified() && (isBootstrappedAdmin() || resource.data.assignedToUid == request.auth.uid || request.auth.uid in resource.data.viewerUids);
      allow create: if isValidId(taskId) && isVerified() && isValidTask(incoming())
        && incoming().id == taskId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(taskId) && isVerified() && isValidTask(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (existing().status != 'COMPLETED'
            && (existing().assignedToUid == request.auth.uid || request.auth.uid in existing().viewerUids)
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'dueDate', 'priority', 'updatedAt']))
        );
      allow delete: if isValidId(taskId) && isAdmin();
    }

    // 9. Appointments
    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId) && isVerified() && (isAdmin() || existing().assignedToUid == request.auth.uid || request.auth.uid in existing().viewerUids);
      allow list: if isVerified() && (isBootstrappedAdmin() || resource.data.assignedToUid == request.auth.uid || request.auth.uid in resource.data.viewerUids);
      allow create: if isValidId(appointmentId) && isVerified() && isValidAppointment(incoming())
        && incoming().id == appointmentId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(appointmentId) && isVerified() && isValidAppointment(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (!(existing().status in ['COMPLETED', 'CANCELLED'])
            && (existing().assignedToUid == request.auth.uid || request.auth.uid in existing().viewerUids)
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'scheduledAt', 'location', 'notes', 'updatedAt']))
        );
      allow delete: if isValidId(appointmentId) && isAdmin();
    }

    // 10. AI Analyses
    match /ai_analyses/{analysisId} {
      allow get: if isValidId(analysisId) && isVerified() && (isAdmin() || request.auth.uid in existing().viewerUids);
      allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.viewerUids);
      allow create: if isValidId(analysisId) && isVerified() && isValidAiAnalysis(incoming())
        && incoming().id == analysisId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(analysisId) && isVerified() && isValidAiAnalysis(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (request.auth.uid in existing().viewerUids
            && incoming().diff(existing()).affectedKeys().hasOnly(['intent', 'propertyType', 'province', 'district', 'budgetMin', 'budgetMax', 'areaMin', 'areaMax', 'legalRequirement', 'leadScore', 'priority', 'summary', 'nextAction', 'isEditedByHuman', 'updatedAt']))
        );
      allow delete: if isValidId(analysisId) && isAdmin();
    }

    // 11. Tags
    match /tags/{tagId} {
      allow get: if isValidId(tagId) && isVerified() && (isAdmin() || request.auth.uid in existing().viewerUids);
      allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.viewerUids);
      allow create: if isValidId(tagId) && isVerified() && isValidTag(incoming())
        && incoming().id == tagId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(tagId) && isManagerOrAbove() && isValidTag(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(tagId) && isAdmin();
