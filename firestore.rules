    // 12. Customer Sources
    match /customer_sources/{sourceId} {
      allow get: if isValidId(sourceId) && isVerified() && (isAdmin() || request.auth.uid in existing().viewerUids);
      allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.viewerUids);
      allow create: if isValidId(sourceId) && isManagerOrAbove() && isValidCustomerSource(incoming())
        && incoming().id == sourceId
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isValidId(sourceId) && isManagerOrAbove() && isValidCustomerSource(incoming())
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(sourceId) && isAdmin();
    }

    // 13. Notifications
    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isVerified() && (isAdmin() || existing().recipientUid == request.auth.uid);
      allow list: if isVerified() && (isBootstrappedAdmin() || resource.data.recipientUid == request.auth.uid);
      allow create: if isValidId(notificationId) && isVerified() && isValidNotification(incoming())
        && incoming().id == notificationId
        && incoming().createdAt == request.time
        && (isAdmin() || incoming().recipientUid == request.auth.uid);
      allow update: if isValidId(notificationId) && isVerified() && isValidNotification(incoming())
        && incoming().id == existing().id
        && incoming().recipientUid == existing().recipientUid
        && incoming().createdAt == existing().createdAt
        && (isAdmin() || (existing().recipientUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])));
      allow delete: if isValidId(notificationId) && (isAdmin() || existing().recipientUid == request.auth.uid);
    }

    // 14. Audit Logs
    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isBootstrappedAdmin() || (isVerified() && resource.data.actorUid == request.auth.uid);
      allow create: if isValidId(logId) && isVerified() && isValidAuditLog(incoming())
        && incoming().id == logId
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }

    // 15. System Settings
    match /system_settings/{settingId} {
      allow get: if isValidId(settingId) && isVerified() && (isAdmin() || request.auth.uid in existing().viewerUids);
      allow list: if isVerified() && (isBootstrappedAdmin() || request.auth.uid in resource.data.viewerUids);
      allow create: if isValidId(settingId) && isAdmin() && isValidSystemSetting(incoming())
        && incoming().id == settingId
        && incoming().updatedByUid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) && isAdmin() && isValidSystemSetting(incoming())
        && incoming().id == existing().id
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }
  }
}
