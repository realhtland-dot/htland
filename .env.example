# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# AI Provider Configuration (gemini | openai)
AI_PROVIDER="gemini"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Meta / Facebook Messenger Platform Configuration
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN="realty_crm_verify_token_2026"
META_GRAPH_API_VERSION="v21.0"

# AES-256-GCM Secret Key for encrypting Page Access Tokens (32 bytes hex or passphrase)
TOKEN_ENCRYPTION_KEY="change_this_to_a_strong_32_byte_secret_key"

# Docker / Production PostgreSQL & Redis (used in docker-compose.yml / Prisma reference)
DATABASE_URL="postgresql://realty:realty_pass@postgres:5432/realty_messenger_crm?schema=public"
REDIS_URL="redis://redis:6379"
JWT_SECRET="change_this_jwt_secret"
JWT_REFRESH_SECRET="change_this_refresh_secret"
NODE_ENV="development"
PORT="3000"
